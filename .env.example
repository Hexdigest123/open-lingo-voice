DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/openlingo_voice"

# JWT Secrets (generate with: openssl rand -base64 32)
JWT_ACCESS_SECRET="your-access-token-secret-min-32-chars"
JWT_REFRESH_SECRET="your-refresh-token-secret-min-32-chars"

# OpenAI API Key Encryption (generate with: openssl rand -hex 32)
# Used to encrypt per-user OpenAI API keys stored in the database
ENCRYPTION_KEY="your-64-char-hex-encryption-key-here"

# ---- Docker Compose variables (for compose.yaml) ----
POSTGRES_USER="root"
POSTGRES_PASSWORD="mysecretpassword"
POSTGRES_DB="openlingo_voice"
APP_PORT="2005"
# The public URL of your deployed app (used for cookies/CORS)
ORIGIN="http://localhost:3000"

# ---- OpenAI (REQUIRED for chat to work) ----
# Global API key used as a fallback for all users.
# Users can also set their own personal key in Settings.
OPENAI_API_KEY="sk-..."
